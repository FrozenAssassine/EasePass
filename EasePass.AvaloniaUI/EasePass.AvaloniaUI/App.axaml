<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:EasePass.AvaloniaUI"
             xmlns:vm="using:EasePass.AvaloniaUI.ViewModels"
             xmlns:views="using:EasePass.AvaloniaUI.Views"
             x:Class="EasePass.AvaloniaUI.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PasswordsViewModel}">
            <views:PasswordsPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>