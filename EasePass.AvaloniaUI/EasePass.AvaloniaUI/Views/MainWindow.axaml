<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasePass.AvaloniaUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:EasePass.AvaloniaUI.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EasePass.AvaloniaUI.Views.MainWindow"
        xmlns:fluentAvalonia="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        Icon="/Assets/avalonia-logo.ico"
        Title="EasePass.AvaloniaUI" >
	<Grid>
		<StackPanel x:Name="infoMessagesPanel"/>
	    <!--There is no frame lol mvvm handles this like react component swapping I guess-->
        <Frame x:Name="MainFrame" />
	</Grid>
</Window>
