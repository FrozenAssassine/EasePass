<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasePass.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:EasePass.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EasePass.Views.MainWindow"
        xmlns:fluentAvalonia="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        x:Name="Root" 
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EasePass" >
	<Grid>
        <StackPanel x:Name="infoMessagesPanel" 
                            VerticalAlignment="Top" 
                            HorizontalAlignment="Center"/>
        <ContentControl Content="{Binding CurrentPage}" />
	</Grid>
</Window>
