<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EasePass.ViewModels.Dialog"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
             x:Class="EasePass.Views.DialogViews.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel">

    <StackPanel Spacing="10" Margin="10" MinWidth="400">
        <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.8"
                   Text="Be sure to select a password that you'll always remember. If the password is lost, so are all your stored credentials, with no means of recovery."/>

        <HeaderedContentControl Header="Current Password" Margin="0,10,0,0">
            <TextBox PasswordChar="*" Classes="RevealPasswordButton"
                     Text="{Binding CurrentPassword}" Watermark="Current Password"/>
        </HeaderedContentControl>

        <HeaderedContentControl Header="New Password">
            <TextBox PasswordChar="*" Classes="RevealPasswordButton"
                     Text="{Binding NewPassword}" Watermark="New Password"/>
        </HeaderedContentControl>

        <HeaderedContentControl Header="Repeat New Password">
            <TextBox PasswordChar="*" Classes="RevealPasswordButton"
                     Text="{Binding RepeatPassword}" Watermark="Repeat Password"/>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
