<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EasePass.ViewModels.Dialog"
             xmlns:controls="using:EasePass.Controls"
             xmlns:avalonia="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="EasePass.Views.DialogViews.GenPasswordPage"
             x:DataType="vm:GenPasswordViewModel">

    <StackPanel Spacing="12" Margin="10" MinWidth="350">
        <ProgressBar IsVisible="{Binding IsGenerating}" IsIndeterminate="True" Height="4"/>

        <HeaderedContentControl Header="Generated Password">
            <controls:CopyPasswordbox Password="{Binding GeneratedPassword}"
                                       Classes="RevealPasswordButton"
                                       Watermark="Generated password"/>
        </HeaderedContentControl>

        <controls:PasswordSafetyChart x:Name="safetyChart" Margin="0,5"/>
    </StackPanel>
</UserControl>
