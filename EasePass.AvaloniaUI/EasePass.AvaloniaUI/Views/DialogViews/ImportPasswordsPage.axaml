<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EasePass.ViewModels.Dialog"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="EasePass.Views.DialogViews.ImportPasswordsPage"
             x:DataType="vm:ImportPasswordsViewModel">

    <StackPanel Spacing="8" Margin="10" MinWidth="400">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Select All" Click="SelectAll_Click"/>
            <Button Content="Deselect All" Click="DeselectAll_Click"/>
        </StackPanel>

        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Passwords}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportPasswordItemWrapper">
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Item.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Item.Username}" Opacity="0.6" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <CheckBox IsChecked="{Binding ConfirmOverwrite}"
                  IsVisible="{Binding ShowOverwriteConfirm}"
                  Content="I confirm I want to overwrite existing passwords"
                  x:Name="confirmOverwriteCheckbox"/>
    </StackPanel>
</UserControl>
