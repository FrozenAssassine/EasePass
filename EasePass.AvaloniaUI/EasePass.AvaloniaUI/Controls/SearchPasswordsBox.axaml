<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:EasePass.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EasePass.Controls.SearchPasswordsBox"
             x:Name="Root"
             x:DataType="controls:SearchPasswordsBox">

    <Grid>
        <AutoCompleteBox x:Name="suggestbox"
                         FilterMode="None"
                         Watermark="{Binding PlaceholderText, ElementName=Root}"/>

        <TextBlock x:Name="infoLabel"
                   Text="{Binding InfoLabel, ElementName=Root}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0,0,30,0"
                   Foreground="Gray"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
