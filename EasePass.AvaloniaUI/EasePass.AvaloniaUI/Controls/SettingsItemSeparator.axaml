<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="100"
             x:Class="EasePass.AvaloniaUI.Controls.SettingsItemSeparator"
             Margin="0,30,0,0">

    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="24"/>
        <ContentPresenter Margin="10,0,0,0" Content="{Binding SettingsContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </StackPanel>
</UserControl>
